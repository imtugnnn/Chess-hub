# Local development configuration for Docker Compose.
# Database and ports use the defaults in docker-compose.yml.
JWT_SECRET=local-only-change-this-secret-1234567890

# Optional: fill these in to enable Google login.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/login/oauth2/code/google

# Gmail API sender OAuth for invitations and password reset (requires gmail.send and offline consent).
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
INVITATION_MAIL_FROM=
