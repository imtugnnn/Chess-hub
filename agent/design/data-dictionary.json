  "constraints": {
    "users": [
      "CREATE UNIQUE INDEX IF NOT EXISTS users_email_key ON users(email);",
      "CREATE UNIQUE INDEX IF NOT EXISTS users_google_subject_key ON users(google_subject);"
    ],
    "student": [
      "CREATE INDEX student_center_idx ON student(center_id) WHERE center_id IS NOT NULL;",
      "CREATE INDEX student_owner_user_idx ON student(owner_user_id) WHERE owner_user_id IS NOT NULL;",
      "CREATE UNIQUE INDEX student_center_identity_unique_idx ON student(center_id, full_name, birth_date, parent_phone_number) WHERE center_id IS NOT NULL;",
      "CREATE UNIQUE INDEX student_owner_identity_unique_idx ON student(owner_user_id, full_name, birth_date, parent_phone_number) WHERE owner_user_id IS NOT NULL;"
    ],
    "class_sessions": [
      "CONSTRAINT class_sessions_time_range_check CHECK (end_time > start_time)",
      "CREATE INDEX IF NOT EXISTS class_sessions_class_date_idx ON class_sessions(class_id, session_date);"
    ],
    "session_attendance": [
      "CONSTRAINT session_attendance_status_check CHECK (status IN ('PRESENT', 'ABSENT', 'LATE'))",
      "CONSTRAINT session_attendance_session_student_key UNIQUE (session_id, student_id)",
      "CREATE INDEX IF NOT EXISTS session_attendance_session_idx ON session_attendance(session_id);"
    ],
    "tournaments": [
      "CREATE INDEX ix_tournaments_teacher_created ON tournaments(teacher_id, created_at DESC);",
      "CREATE INDEX ix_tournaments_class ON tournaments(class_id);"
    ],
    "tournament_participants": [
      "CREATE UNIQUE INDEX IF NOT EXISTS uq_tournament_participants_tournament_student ON tournament_participants(tournament_id, student_id);"
    ],
    "tournament_tie_breaks": [
      "CREATE UNIQUE INDEX IF NOT EXISTS uq_tournament_tie_breaks_tournament_type ON tournament_tie_breaks(tournament_id, tie_break_type);"
    ],
    "tournament_rounds": [
      "CREATE UNIQUE INDEX IF NOT EXISTS uq_tournament_rounds_tournament_number ON tournament_rounds(tournament_id, round_number);"
    ],
    "tournament_pairings": [
      "CREATE UNIQUE INDEX IF NOT EXISTS uq_tournament_pairings_round_board ON tournament_pairings(round_id, board_number);"
    ],
    "centers": [
      "CONSTRAINT centers_subscription_status_check\n    CHECK (subscription_status IN ('ACTIVE', 'PAST_DUE', 'CANCELLED', 'EXPIRED'))",
      "CREATE INDEX centers_owner_user_idx ON centers(owner_user_id);"
    ],
    "center_memberships": [
      "PRIMARY KEY (center_id, user_id)",
      "CONSTRAINT center_memberships_role_check\n    CHECK (role IN ('OWNER', 'ADMIN', 'TEACHER'))",
      "CONSTRAINT center_memberships_status_check\n    CHECK (status IN ('ACTIVE', 'SUSPENDED', 'LEFT'))",
      "CREATE INDEX center_memberships_user_idx ON center_memberships(user_id) WHERE status = 'ACTIVE';"
    ],
    "center_invitations": [
      "CONSTRAINT center_invitations_role_check\n    CHECK (role IN ('ADMIN', 'TEACHER'))",
      "CONSTRAINT center_invitations_status_check\n    CHECK (status IN ('PENDING', 'ACCEPTED', 'DECLINED', 'CANCELLED'))",
      "CREATE UNIQUE INDEX center_invitations_pending_unique_idx ON center_invitations(center_id, invited_user_id) WHERE status = 'PENDING';",
      "CREATE INDEX center_invitations_invited_user_idx ON center_invitations(invited_user_id) WHERE status = 'PENDING';"
    ],
    "chess_classes": [
      "CONSTRAINT chess_classes_fee_per_session_check CHECK (fee_per_session >= 0)"
    ],
    "remember_login_tokens": [
      "CREATE INDEX IF NOT EXISTS remember_login_tokens_expiry_idx ON remember_login_tokens(expires_at);"
    ],
    "teaching_materials": [
      "CONSTRAINT material_owner_check CHECK ((owner_user_id IS NULL) <> (center_id IS NULL))",
      "CONSTRAINT material_source_check CHECK ((source_url IS NULL) <> (file_data IS NULL))",
      "CREATE INDEX teaching_materials_owner_idx ON teaching_materials(owner_user_id) WHERE deleted_at IS NULL;",
      "CREATE INDEX teaching_materials_center_idx ON teaching_materials(center_id) WHERE deleted_at IS NULL;"
    ],
    "session_materials": [
      "PRIMARY KEY (session_id, material_id)"
    ],
    "password_reset_tokens": [
      "CREATE INDEX password_reset_tokens_user_idx ON password_reset_tokens(user_id);"
    ],
    "chess_class_students": [
      "Bảng nối @ManyToMany từ Set<Student>; schema vật lý do Hibernate sinh, chưa có CREATE TABLE Flyway riêng. Không xác nhận tên constraint vật lý khi chưa introspect DB."
    ]
